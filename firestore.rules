rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // The keys this write adds, removes or changes.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isEstateAdmin(estateId) {
      return isSignedIn()
             && uid() in get(/databases/$(database)/documents/estates/$(estateId)).data.adminIds;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, delete: if isSignedIn() && uid() == userId;
      allow update: if isSignedIn() && (
        uid() == userId
        // An estate admin approving a join request attaches the member to their estate.
        // That is the only field they may touch on somebody else's profile.
        || (changedKeys().hasOnly(['estateId'])
            && isEstateAdmin(request.resource.data.estateId))
      );
    }

    match /estates/{estateId} {
      allow read: if isSignedIn();
      // Whoever creates an estate must be an admin of it, so it always has an owner.
      allow create: if isSignedIn() && uid() in request.resource.data.adminIds;
      allow update: if isSignedIn() && (
        uid() in resource.data.adminIds
        // Joining or leaving adjusts the member tally and nothing else — in particular
        // it must not let a member write themselves into adminIds.
        || changedKeys().hasOnly(['memberCount'])
      );
      allow delete: if isSignedIn() && uid() in resource.data.adminIds;
    }

    match /joinRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.userId == uid() || isEstateAdmin(resource.data.estateId)
      );
      allow create: if isSignedIn()
                    && request.resource.data.userId == uid()
                    && request.resource.data.estateId is string
                    && request.resource.data.status == 'pending';
      // Approving or denying is an admin decision; a requester cannot approve their own.
      allow update: if changedKeys().hasOnly(['status'])
                    && isEstateAdmin(resource.data.estateId);
      // Requesters withdraw their own request.
      allow delete: if isSignedIn() && resource.data.userId == uid();
    }

    match /notifications/{notificationId} {
      // Raised by whoever triggered the event (a join requester notifying an admin),
      // so at create time the recipient is somebody other than the writer.
      allow create: if isSignedIn()
                    && request.resource.data.recipientId is string
                    && request.resource.data.isRead == false;
      allow read, delete: if isSignedIn() && resource.data.recipientId == uid();
      allow update: if isSignedIn()
                    && resource.data.recipientId == uid()
                    && changedKeys().hasOnly(['isRead']);
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == uid();
      allow update: if isSignedIn() && (
        resource.data.authorId == uid()
        // A neighbour may like a post or comment on it. Neither may rewrite its body.
        || changedKeys().hasOnly(['likedBy', 'likeCount'])
        || changedKeys().hasOnly(['commentCount'])
      );
      allow delete: if isSignedIn() && resource.data.authorId == uid();

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.authorId == uid();
        allow update: if false;
        // The comment's author, or the author of the post being commented on.
        allow delete: if isSignedIn() && (
          resource.data.authorId == uid()
          || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == uid()
        );
      }
    }

    match /chats/{chatId} {
      function chatParticipants() {
        return get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }

      // createOrGetChat probes for the document before creating it, and a rule that
      // errors on a missing document surfaces as PERMISSION_DENIED rather than "absent".
      allow get: if isSignedIn() && (resource == null || uid() in resource.data.participants);
      allow list: if isSignedIn() && uid() in resource.data.participants;
      allow create: if isSignedIn()
                    && uid() in request.resource.data.participants
                    && request.resource.data.participants.size() == 2;
      // Participants keep lastMessage and their unread tallies current.
      allow update: if isSignedIn() && uid() in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn() && uid() in chatParticipants();
        allow create: if isSignedIn()
                      && request.resource.data.senderId == uid()
                      && uid() in chatParticipants();
        // Messages are immutable once sent.
        allow update, delete: if false;
      }
    }

  }
}
