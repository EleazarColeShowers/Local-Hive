rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // The keys this write adds, removes or changes.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Posts and comments can be edited for 30 minutes after they're written (EDIT_WINDOW_MILLIS in
    // the app), plus two minutes for phones whose clocks run a little behind.
    function withinEditWindow() {
      return request.time.toMillis() < resource.data.get('createdAt', 0) + 32 * 60 * 1000;
    }

    // The estate the caller currently belongs to, or null.
    function myEstateId() {
      return get(/databases/$(database)/documents/users/$(uid())).data.get('estateId', null);
    }

    function isMemberOf(estateId) {
      return isSignedIn() && estateId != null && myEstateId() == estateId;
    }

    function isEstateAdmin(estateId) {
      return isSignedIn()
             && uid() in get(/databases/$(database)/documents/estates/$(estateId)).data.adminIds;
    }

    // The member an admin appointed to look after the estate's money.
    function isTreasurerOf(estateId) {
      return isSignedIn()
             && get(/databases/$(database)/documents/estates/$(estateId)).data.get('treasurerId', '') == uid();
    }

    // As isEstateAdmin, but sees writes earlier in the same batch — creating an estate
    // and attaching its creator to it happen together.
    function isEstateAdminAfter(estateId) {
      return isSignedIn()
             && uid() in getAfter(/databases/$(database)/documents/estates/$(estateId)).data.adminIds;
    }

    // A join request is the only way into an estate besides creating it. Admins approve
    // requests; a valid invite code lets the requester approve their own.
    function hasApprovedRequest(estateId, userId) {
      return getAfter(/databases/$(database)/documents/joinRequests/$(estateId + '_' + userId)).data.status == 'approved';
    }

    function inviteCodeOpens(code, estateId) {
      return code is string
             && get(/databases/$(database)/documents/inviteCodes/$(code)).data.estateId == estateId;
    }

    // A security guard an admin let in at the gate. Guards are never members: they don't live
    // there, so isMemberOf stays false for them and the feed, chats, money and the directory
    // stay closed. All they get is the visitor passes below, one code at a time.
    function isGuardOf(estateId) {
      return isSignedIn()
             && exists(/databases/$(database)/documents/estates/$(estateId)/guards/$(uid()));
    }

    // Profiles from 1.07 on don't carry the email, since neighbours can read them. Switch this on
    // once everyone has updated, so a 1.06 phone can't write it back.
    function strictProfiles() {
      return false;
    }

    // Posts and comments need a short gap between them (postingLimits below), so a script can't
    // flood an estate. 1.07 doesn't stamp the gap, so switch this on once everyone has 1.08.
    function postingLimitsOn() {
      return false;
    }

    function postingLimitPath() {
      return /databases/$(database)/documents/postingLimits/$(uid());
    }

    // This post or comment is the one the caller just stamped as their latest, at this moment.
    // Naming it by id means a batch can't carry a pile of posts on one stamp.
    function stampedFor(field, idField, docId) {
      return !postingLimitsOn()
             || (existsAfter(postingLimitPath())
                 && getAfter(postingLimitPath()).data.get(field, null) == request.time
                 && getAfter(postingLimitPath()).data.get(idField, '') == docId);
    }

    function noEmail() {
      return !strictProfiles() || !('email' in request.resource.data);
    }

    // When each person last posted and commented, kept by the app beside the post or comment
    // itself. A new stamp must be the server's time now and come long enough after the last one:
    // 20 seconds between posts, 3 between comments.
    match /postingLimits/{userId} {
      function spacedOut(field, seconds) {
        let before = resource == null ? null : resource.data.get(field, null);
        let after = request.resource.data.get(field, null);
        return after == before
               || (after == request.time
                   && (before == null || request.time > before + duration.value(seconds, 's')));
      }

      allow read: if isSignedIn() && uid() == userId;
      allow create, update: if isSignedIn()
                            && uid() == userId
                            && request.resource.data.keys().hasOnly(['lastPostAt', 'lastPostId', 'lastCommentAt', 'lastCommentId'])
                            && spacedOut('lastPostAt', 20)
                            && spacedOut('lastCommentAt', 3);
    }

    match /users/{userId} {
      // Neighbours see each other; nobody sees residents of other estates.
      // Written against resource.data.estateId directly so the directory's
      // `estateId == X` query can be proven safe as a whole.
      allow read: if isSignedIn() && (
        uid() == userId
        || (myEstateId() != null && resource.data.estateId == myEstateId())
      );
      // New accounts start outside any estate and must join one through the flow below.
      allow create: if isSignedIn() && uid() == userId
                    && request.resource.data.get('estateId', null) == null
                    && noEmail();
      allow update: if isSignedIn() && (
        (uid() == userId && noEmail() && (
          !('estateId' in changedKeys())
          // Leaving.
          || request.resource.data.get('estateId', null) == null
          // Joining: an estate they just created, or one that has let them in.
          || isEstateAdminAfter(request.resource.data.estateId)
          || hasApprovedRequest(request.resource.data.estateId, userId)
        ))
        // An admin approving a request attaches that requester, and only that requester,
        // to their estate. It is the only field they may touch on somebody else's profile.
        || (changedKeys().hasOnly(['estateId'])
            && isEstateAdmin(request.resource.data.estateId)
            && hasApprovedRequest(request.resource.data.estateId, userId))
        // An admin removing a member from their estate. Admins (and so the owner) have to
        // lose admin first, so one admin can't throw out another in a single step.
        || (changedKeys().hasOnly(['estateId'])
            && request.resource.data.get('estateId', null) == null
            && resource.data.get('estateId', null) is string
            && isEstateAdmin(resource.data.estateId)
            && !(userId in get(/databases/$(database)/documents/estates/$(resource.data.estateId)).data.adminIds))
      );
      allow delete: if isSignedIn() && uid() == userId;

      // People this user has blocked. Private: the blocked person can't tell.
      match /blocks/{blockedId} {
        allow read, delete: if isSignedIn() && uid() == userId;
        allow create, update: if isSignedIn() && uid() == userId && blockedId != userId;
      }
    }

    match /estates/{estateId} {
      // Public so people can find an estate to request; invite codes live elsewhere.
      allow read: if isSignedIn();
      // Whoever creates an estate must be an admin of it, so it always has an owner.
      allow create: if isSignedIn()
                    && request.resource.data.adminIds is list
                    && uid() in request.resource.data.adminIds
                    && request.resource.data.ownerId == uid()
                    && request.resource.data.memberCount == 1
                    && nameLowerMatches()
                    && !('inviteCode' in request.resource.data);
      allow update: if isSignedIn() && (
        (uid() in resource.data.adminIds
          && !('inviteCode' in request.resource.data)
          && detailsValid()
          && ownerKept())
        // Joining or leaving moves the tally by one and touches nothing else — in
        // particular a member cannot write themselves into adminIds. The caller's own profile
        // must move into or out of the estate in the same batch, so the count can't be pushed
        // around by someone who isn't coming or going.
        || (changedKeys().hasOnly(['memberCount'])
            && ((request.resource.data.memberCount == resource.data.memberCount + 1 && joiningNow())
                || (request.resource.data.memberCount == resource.data.memberCount - 1 && leavingNow())))
        // A treasurer who isn't an admin gives the role up as they leave, and nothing more.
        || (changedKeys().hasOnly(['memberCount', 'treasurerId'])
            && resource.data.get('treasurerId', '') == uid()
            && request.resource.data.get('treasurerId', '') == ''
            && request.resource.data.memberCount == resource.data.memberCount - 1
            && leavingNow())
      );

      // The caller's profile, before and after this batch.
      function myEstateAfter() {
        return getAfter(/databases/$(database)/documents/users/$(uid())).data.get('estateId', null);
      }

      function joiningNow() {
        return myEstateId() != estateId && myEstateAfter() == estateId;
      }

      function leavingNow() {
        return myEstateId() == estateId && myEstateAfter() != estateId;
      }
      // Only the owner can delete the whole estate, so one rogue admin can't wipe it out.
      // Estates from before ownership was tracked belong to their first admin.
      allow delete: if isSignedIn()
                    && resource.data.get('ownerId', resource.data.adminIds[0]) == uid();

      // An estate always has a name, and lets people in in one of the known ways.
      function detailsValid() {
        let data = request.resource.data;
        return data.name is string
               && data.name.size() > 0
               && data.name.size() <= 80
               && data.get('address', '') is string
               && data.get('address', '').size() <= 200
               && data.get('joinMode', 'both') in ['both', 'code', 'request']
               && nameLowerMatches();
      }

      // Search runs on nameLower, so it can't be set to anything but the name in lowercase.
      // Estates from before it existed may lack it until the worker's hourly job fills it in.
      function nameLowerMatches() {
        let data = request.resource.data;
        return data.get('nameLower', data.name.lower()) == data.name.lower();
      }

      // The owner stays an admin no matter what other admins do. Only the owner can change
      // that, by handing ownership to another member, who becomes an admin with it. The
      // owner may stay on as an admin, or drop admin as they leave.
      function ownerKept() {
        let owner = resource.data.get('ownerId', null);
        let next = request.resource.data.get('ownerId', null);
        return (next == owner && (owner == null || owner in request.resource.data.adminIds))
               || (uid() == owner
                   && next is string
                   && next != owner
                   && next in request.resource.data.adminIds
                   && get(/databases/$(database)/documents/users/$(next)).data.get('estateId', null) == estateId);
      }

      // ───── Money ─────
      //
      // The treasurer runs the books, and everything they do to them leaves an entry in the
      // estate's finance log, which every member can read and nobody can change or delete.
      // Writes that only the current app makes must carry their log entry now. Writes the
      // previous app also makes (per-member levies, expenses, bank details) get the same check
      // once strictFinance() is switched on, after everyone has updated.
      function strictFinance() {
        return false;
      }

      function logPath(entryId) {
        return /databases/$(database)/documents/estates/$(estateId)/financeLog/$(entryId);
      }

      function logged(entryId) {
        return existsAfter(logPath(entryId)) && getAfter(logPath(entryId)).data.by == uid();
      }

      function nowMs() {
        return request.time.toMillis();
      }

      // A moment stamped by the app, within an hour of the server's clock.
      function isFresh(millis) {
        return millis is int && math.abs(millis - nowMs()) < 60 * 60 * 1000;
      }

      match /financeLog/{entryId} {
        allow read: if isMemberOf(estateId);
        allow create: if isTreasurerOf(estateId)
                      && request.resource.data.keys().hasOnly(['action', 'summary', 'amount', 'by', 'byName', 'at'])
                      && request.resource.data.by == uid()
                      && isFresh(request.resource.data.at)
                      && request.resource.data.action is string
                      && request.resource.data.action.size() <= 40
                      && request.resource.data.summary is string
                      && request.resource.data.summary.size() <= 300
                      && request.resource.data.get('amount', 0) is int
                      && request.resource.data.get('byName', '') is string
                      && request.resource.data.get('byName', '').size() <= 100;
        allow update, delete: if false;
      }

      // Dues charged to every member: the treasurer sets them; every member can see what's owed.
      // hasPayments goes on once a payment is confirmed, and from then on the levy can't be
      // deleted, so a paid-up member's record can't be wiped out with it.
      match /levies/{levyId} {
        allow read: if isMemberOf(estateId);
        allow create: if isTreasurerOf(estateId)
                      && request.resource.data.title is string
                      && request.resource.data.amount is int
                      && request.resource.data.amount > 0
                      && request.resource.data.get('hasPayments', false) == false
                      && (!strictFinance() || logged('levy_' + levyId + '_created'));
        allow update: if isTreasurerOf(estateId)
                      && changedKeys().hasOnly(['hasPayments'])
                      && request.resource.data.hasPayments == true;
        allow delete: if isTreasurerOf(estateId)
                      && resource.data.get('hasPayments', false) != true
                      && (!strictFinance() || logged('levy_' + levyId + '_deleted'));

        function levy() {
          return get(/databases/$(database)/documents/estates/$(estateId)/levies/$(levyId)).data;
        }

        // One per resident, keyed by their uid. Only they and the treasurer can see it.
        match /payments/{userId} {
          allow read: if isSignedIn() && (uid() == userId || isTreasurerOf(estateId));
          // A resident sends proof for themselves, for the levy's amount. It always arrives
          // pending, and can't be replaced once the treasurer has confirmed it.
          allow create, update: if (isSignedIn()
                                    && uid() == userId
                                    && isMemberOf(estateId)
                                    && request.resource.data.userId == uid()
                                    && request.resource.data.status == 'pending'
                                    && request.resource.data.amount == levy().amount
                                    && request.resource.data.keys().hasOnly(
                                         ['userId', 'userName', 'levyId', 'amount', 'status', 'proofUrl', 'submittedAt'])
                                    && (resource == null || resource.data.status != 'paid'))
                                // The treasurer confirms, rejects or records a cash payment. Taking
                                // back a confirmed payment needs a reason, which goes in the log.
                                || (isTreasurerOf(estateId)
                                    && request.resource.data.userId == userId
                                    && request.resource.data.status in ['pending', 'paid', 'rejected']
                                    && (resource == null
                                        || resource.data.status != 'paid'
                                        || request.resource.data.status == 'paid'
                                        || (request.resource.data.get('undoReason', '') is string
                                            && request.resource.data.get('undoReason', '').size() > 0))
                                    && (!strictFinance()
                                        || (logged('pay_' + levyId + '_' + userId + '_' + string(request.resource.data.reviewedAt))
                                            && (request.resource.data.status != 'paid'
                                                || getAfter(/databases/$(database)/documents/estates/$(estateId)/levies/$(levyId)).data.get('hasPayments', false) == true))));
          // A confirmed payment stays on the books.
          allow delete: if isTreasurerOf(estateId) && resource.data.status != 'paid';
        }
      }

      // The estate's buildings, each with its number of flats, for dues charged per flat. The
      // treasurer or an admin keeps the list.
      match /buildings/{buildingId} {
        allow read: if isMemberOf(estateId);
        allow create, update: if (isTreasurerOf(estateId) || isEstateAdmin(estateId))
                              && request.resource.data.keys().hasOnly(['name', 'flats', 'createdBy', 'createdAt'])
                              && request.resource.data.name is string
                              && request.resource.data.name.size() > 0
                              && request.resource.data.name.size() <= 80
                              && request.resource.data.flats is int
                              && request.resource.data.flats >= 1
                              && request.resource.data.flats <= 200;
        allow delete: if isTreasurerOf(estateId) || isEstateAdmin(estateId);
      }

      // Where each member lives: one per member, keyed by their uid. They pick it themselves;
      // the treasurer or an admin can correct a wrong pick.
      function buildingOf(buildingId) {
        return get(/databases/$(database)/documents/estates/$(estateId)/buildings/$(buildingId)).data;
      }

      function residentPath(userId) {
        return /databases/$(database)/documents/estates/$(estateId)/residents/$(userId);
      }

      // The building the caller lives in, or '' if they haven't said.
      function myBuilding() {
        return exists(residentPath(uid())) ? get(residentPath(uid())).data.buildingId : '';
      }

      match /residents/{userId} {
        allow read: if isMemberOf(estateId);
        allow create, update: if isMemberOf(estateId)
                              && (uid() == userId || isTreasurerOf(estateId) || isEstateAdmin(estateId))
                              && request.resource.data.keys().hasOnly(['buildingId', 'buildingName', 'flat', 'userName', 'setBy', 'at'])
                              && request.resource.data.setBy == uid()
                              && request.resource.data.buildingId is string
                              && request.resource.data.flat is int
                              && request.resource.data.flat >= 1
                              && request.resource.data.flat <= buildingOf(request.resource.data.buildingId).flats
                              && request.resource.data.get('userName', '') is string
                              && request.resource.data.get('userName', '').size() <= 100;
        allow delete: if isSignedIn()
                      && (uid() == userId || isTreasurerOf(estateId) || isEstateAdmin(estateId));
      }

      // Dues charged per flat: each flat in every building owes [amount]. Kept apart from
      // levies so the previous app, which can't show them properly, doesn't see them at all.
      match /flatLevies/{levyId} {
        function flatLevy() {
          return get(/databases/$(database)/documents/estates/$(estateId)/flatLevies/$(levyId)).data;
        }

        function flatLevyAfter() {
          return getAfter(/databases/$(database)/documents/estates/$(estateId)/flatLevies/$(levyId)).data;
        }

        allow read: if isMemberOf(estateId);
        allow create: if isTreasurerOf(estateId)
                      && request.resource.data.keys().hasOnly(['title', 'amount', 'dueDate', 'note', 'createdBy', 'createdAt', 'hasPayments'])
                      && request.resource.data.title is string
                      && request.resource.data.title.size() > 0
                      && request.resource.data.title.size() <= 80
                      && request.resource.data.amount is int
                      && request.resource.data.amount > 0
                      && request.resource.data.createdBy == uid()
                      && request.resource.data.hasPayments == false
                      && logged('levy_' + levyId + '_created');
        allow update: if isTreasurerOf(estateId)
                      && changedKeys().hasOnly(['hasPayments'])
                      && request.resource.data.hasPayments == true;
        allow delete: if isTreasurerOf(estateId)
                      && resource.data.get('hasPayments', false) != true
                      && logged('levy_' + levyId + '_deleted');

        // One per flat, keyed "<buildingId>_<flat>". Neighbours in the same building can see
        // which flats have paid, and who paid; the proof itself is kept in proofs below.
        match /flats/{flatId} {
          function flatValid(data) {
            return data.keys().hasOnly(['buildingId', 'buildingName', 'flat', 'levyId', 'amount', 'status', 'payerId',
                                        'payerName', 'groupId', 'submittedAt', 'reviewedAt', 'confirmedByName', 'undoReason'])
                   && data.buildingId is string
                   && data.flat is int
                   && flatId == data.buildingId + '_' + string(data.flat)
                   && data.flat >= 1
                   && data.flat <= buildingOf(data.buildingId).flats
                   && data.levyId == levyId
                   && data.amount == flatLevy().amount
                   && data.groupId is string
                   && data.groupId.size() <= 100
                   && data.get('payerName', '') is string
                   && data.get('payerName', '').size() <= 100
                   && data.get('buildingName', '') is string
                   && data.get('buildingName', '').size() <= 80;
          }

          allow read: if isTreasurerOf(estateId)
                      || (isMemberOf(estateId) && resource.data.buildingId == myBuilding());
          // A resident sends proof for flats in their own building that haven't paid or are
          // waiting: never over a payment someone else already has in. The proof goes in the
          // same batch.
          allow create, update: if (isMemberOf(estateId)
                                    && flatValid(request.resource.data)
                                    && request.resource.data.buildingId == myBuilding()
                                    && request.resource.data.status == 'pending'
                                    && request.resource.data.payerId == uid()
                                    && isFresh(request.resource.data.submittedAt)
                                    && request.resource.data.get('reviewedAt', 0) == 0
                                    && !('undoReason' in request.resource.data)
                                    && (resource == null || resource.data.status == 'rejected')
                                    && getAfter(/databases/$(database)/documents/estates/$(estateId)/flatLevies/$(levyId)/proofs/$(request.resource.data.groupId)).data.payerId == uid())
                                // The treasurer confirms or rejects proof, records a cash payment,
                                // or takes a confirmation back with a reason. Every change is
                                // logged, and a confirmation marks the levy as paid into.
                                || (isTreasurerOf(estateId)
                                    && flatValid(request.resource.data)
                                    && request.resource.data.status in ['paid', 'rejected', 'pending']
                                    && isFresh(request.resource.data.reviewedAt)
                                    && (resource == null
                                        || resource.data.status != 'paid'
                                        || request.resource.data.status == 'paid'
                                        || (request.resource.data.get('undoReason', '') is string
                                            && request.resource.data.get('undoReason', '').size() > 0))
                                    && (request.resource.data.status != 'paid' || flatLevyAfter().get('hasPayments', false) == true)
                                    && logged('flat_' + levyId + '_' + request.resource.data.groupId + '_' + string(request.resource.data.reviewedAt)));
          allow delete: if false;
        }

        // One proof of payment, covering one or more flats. Only the payer and the treasurer
        // can see it, since a bank screenshot can show account details.
        match /proofs/{groupId} {
          allow read: if isSignedIn() && (resource.data.payerId == uid() || isTreasurerOf(estateId));
          allow create: if isMemberOf(estateId)
                        && request.resource.data.keys().hasOnly(['payerId', 'payerName', 'buildingId', 'flats', 'amount', 'proofUrl', 'submittedAt'])
                        && request.resource.data.payerId == uid()
                        && request.resource.data.buildingId == myBuilding()
                        && request.resource.data.flats is list
                        && request.resource.data.flats.size() >= 1
                        && request.resource.data.flats.size() <= 200
                        && request.resource.data.amount == flatLevy().amount * request.resource.data.flats.size()
                        && request.resource.data.proofUrl is string
                        && request.resource.data.proofUrl.size() <= 1000
                        && isFresh(request.resource.data.submittedAt);
          allow update, delete: if false;
        }
      }

      // Spending is logged by the treasurer and open to every member, for transparency. An
      // expense can be taken back within a day of adding it, for mistakes; after that it stays.
      match /expenses/{expenseId} {
        allow read: if isMemberOf(estateId);
        allow create: if isTreasurerOf(estateId)
                      && request.resource.data.amount is int
                      && request.resource.data.amount > 0
                      && isFresh(request.resource.data.createdAt)
                      && (!strictFinance() || logged('expense_' + expenseId + '_added'));
        allow update: if false;
        allow delete: if isTreasurerOf(estateId)
                      && nowMs() < resource.data.get('createdAt', 0) + 24 * 60 * 60 * 1000
                      && (!strictFinance() || logged('expense_' + expenseId + '_deleted'));
      }

      // People an admin removed. They can't let themselves back in with an invite code; an
      // admin approving a request from them clears this.
      match /removed/{userId} {
        allow read: if isEstateAdmin(estateId);
        allow create: if isEstateAdmin(estateId)
                      && request.resource.data.keys().hasOnly(['name', 'removedBy', 'at'])
                      && request.resource.data.removedBy == uid()
                      && isFresh(request.resource.data.at);
        allow update: if false;
        allow delete: if isEstateAdmin(estateId);
      }

      // Members-only details: the current invite code, which admins set, and where to pay
      // dues, which the treasurer sets.
      match /private/{docId} {
        allow read: if isMemberOf(estateId) || isEstateAdmin(estateId);
        allow create, update: if (docId != 'bank' && isEstateAdminAfter(estateId))
                              || (docId == 'bank'
                                  && isTreasurerOf(estateId)
                                  && request.resource.data.keys().hasOnly(
                                       ['bankName', 'accountNumber', 'accountName', 'updatedBy', 'updatedByName', 'updatedAt'])
                                  && request.resource.data.updatedBy == uid()
                                  // Stamped with the real time, so a change can't be passed off as an old one.
                                  && request.resource.data.updatedAt is int
                                  && math.abs(request.resource.data.updatedAt - request.time.toMillis()) < 60 * 60 * 1000
                                  && request.resource.data.accountNumber is string
                                  && request.resource.data.accountNumber.size() > 0
                                  && request.resource.data.accountNumber.size() <= 20
                                  && (!strictFinance() || logged('bank_' + string(request.resource.data.updatedAt))));
        allow delete: if (docId != 'bank' && isEstateAdminAfter(estateId))
                      || (docId == 'bank' && isTreasurerOf(estateId));
      }

      // An admin's SOS settings for one member: their alerts turned off, or the siren given back
      // after false alarms (restoredAt). The member can see their own; admins see everyone's.
      match /sosMembers/{memberId} {
        allow read: if isEstateAdmin(estateId) || (isSignedIn() && uid() == memberId);
        allow create, update: if isEstateAdmin(estateId)
                              && memberId != uid()
                              && request.resource.data.keys().hasOnly(['disabled', 'restoredAt', 'updatedBy', 'updatedAt'])
                              && request.resource.data.updatedBy == uid()
                              && request.resource.data.get('disabled', false) is bool
                              && request.resource.data.get('restoredAt', 0) is int;
        allow delete: if isEstateAdmin(estateId);
      }

      // One per emergency marked a false alarm, keyed by the post, counting against its sender.
      // The sender or an admin writes it, in a batch that marks the post; the sender can't remove
      // it, even by deleting the post. Only an admin can.
      match /falseAlarms/{postId} {
        function alarmPost() {
          return get(/databases/$(database)/documents/posts/$(postId)).data;
        }

        allow read: if isEstateAdmin(estateId) || (isSignedIn() && resource.data.userId == uid());
        allow create: if isSignedIn()
                      && request.resource.data.keys().hasOnly(['userId', 'postId', 'markedBy', 'markedByName', 'at'])
                      && request.resource.data.postId == postId
                      && request.resource.data.markedBy == uid()
                      && request.resource.data.at is int
                      && math.abs(request.resource.data.at - request.time.toMillis()) < 60 * 60 * 1000
                      && alarmPost().estateId == estateId
                      && alarmPost().category == 'emergency'
                      && request.resource.data.userId == alarmPost().authorId
                      && (isEstateAdmin(estateId) || alarmPost().authorId == uid())
                      && getAfter(/databases/$(database)/documents/posts/$(postId)).data.get('falseAlarm', false) == true;
        allow update: if false;
        allow delete: if isEstateAdmin(estateId);
      }

      // Polls: admins ask, every member votes once and may move that vote while the poll is open.
      // The tallies live on the poll for all to see; each vote is a separate document only its voter can read. A vote and its tally are
      // written in one batch, and the two rules below hold each to the other.
      function pollPath(pollId) {
        return /databases/$(database)/documents/estates/$(estateId)/polls/$(pollId);
      }

      function votePath(pollId) {
        return /databases/$(database)/documents/estates/$(estateId)/pollVotes/$(pollId + '_' + uid());
      }

      function pollOpen(poll) {
        return poll.closed == false
               && (poll.closesAt == 0 || request.time.toMillis() < poll.closesAt);
      }

      match /polls/{pollId} {
        allow read: if isMemberOf(estateId);
        allow create: if isEstateAdmin(estateId)
                      && request.resource.data.createdBy == uid()
                      && request.resource.data.question is string
                      && request.resource.data.question.size() > 0
                      && request.resource.data.question.size() <= 200
                      && request.resource.data.options is list
                      && request.resource.data.options.size() >= 2
                      && request.resource.data.options.size() <= 6
                      && request.resource.data.closesAt is int
                      && request.resource.data.closed == false
                      && request.resource.data.counts.size() == 0
                      && request.resource.data.voteCount == 0;
        allow update: if (isEstateAdmin(estateId)
                          && changedKeys().hasOnly(['closed'])
                          && request.resource.data.closed == true)
                      || tallyForNewVote()
                      || tallyForChangedVote();
        allow delete: if isEstateAdmin(estateId);

        // The caller's vote document appears in this same batch, and the option it names, and
        // only that one, goes up by one.
        function tallyForNewVote() {
          let option = string(getAfter(votePath(pollId)).data.option);
          return isMemberOf(estateId)
                 && pollOpen(resource.data)
                 && !exists(votePath(pollId))
                 && existsAfter(votePath(pollId))
                 && changedKeys().hasOnly(['counts', 'voteCount'])
                 && request.resource.data.voteCount == resource.data.voteCount + 1
                 && request.resource.data.counts.diff(resource.data.counts).affectedKeys().hasOnly([option])
                 && request.resource.data.counts[option] == resource.data.counts.get(option, 0) + 1;
        }

        // The caller moves their existing vote in this same batch: the old option goes down by
        // one, the new one up by one, and the total stays put.
        function tallyForChangedVote() {
          let from = string(get(votePath(pollId)).data.option);
          let to = string(getAfter(votePath(pollId)).data.option);
          return isMemberOf(estateId)
                 && pollOpen(resource.data)
                 && exists(votePath(pollId))
                 && from != to
                 && changedKeys().hasOnly(['counts'])
                 && request.resource.data.counts.diff(resource.data.counts).affectedKeys().hasOnly([from, to])
                 && request.resource.data.counts[to] == resource.data.counts.get(to, 0) + 1
                 && request.resource.data.counts[from] == resource.data.counts.get(from, 0) - 1;
        }
      }

      match /pollVotes/{voteId} {
        allow read: if isSignedIn() && resource.data.userId == uid();
        // One per member per poll, keyed "<pollId>_<uid>". It can move to another option while the
        // poll is open, in a batch with the matching tally change, but is never removed.
        allow create: if isMemberOf(estateId)
                      && request.resource.data.keys().hasOnly(['pollId', 'userId', 'option', 'at'])
                      && request.resource.data.userId == uid()
                      && request.resource.data.pollId is string
                      && voteId == request.resource.data.pollId + '_' + uid()
                      && request.resource.data.option is int
                      && request.resource.data.option >= 0
                      && request.resource.data.option < get(pollPath(request.resource.data.pollId)).data.options.size()
                      && getAfter(pollPath(request.resource.data.pollId)).data.voteCount
                         == get(pollPath(request.resource.data.pollId)).data.voteCount + 1;
        allow update: if isMemberOf(estateId)
                      && resource.data.userId == uid()
                      && request.resource.data.keys().hasOnly(['pollId', 'userId', 'option', 'at'])
                      && request.resource.data.userId == uid()
                      && request.resource.data.pollId == resource.data.pollId
                      && request.resource.data.option is int
                      && request.resource.data.option != resource.data.option
                      && request.resource.data.option >= 0
                      && request.resource.data.option < get(pollPath(resource.data.pollId)).data.options.size()
                      && pollOpen(get(pollPath(resource.data.pollId)).data)
                      && getAfter(pollPath(resource.data.pollId)).data.counts[string(request.resource.data.option)]
                         == get(pollPath(resource.data.pollId)).data.counts.get(string(request.resource.data.option), 0) + 1;
        allow delete: if false;
      }

      // "Is there light?": the latest word on each supply, and every report behind it.
      match /utilities/{kind} {
        allow read: if isMemberOf(estateId);
        allow create, update: if isMemberOf(estateId)
                              && kind == 'power'
                              && request.resource.data.keys().hasOnly(['isOn', 'since', 'updatedAt', 'updatedBy', 'updatedByName'])
                              && request.resource.data.isOn is bool
                              && request.resource.data.updatedBy == uid();
        allow delete: if false;
      }

      match /utilityReports/{reportId} {
        allow read: if isMemberOf(estateId);
        allow create: if isMemberOf(estateId)
                      && request.resource.data.keys().hasOnly(['kind', 'isOn', 'by', 'byName', 'at'])
                      && request.resource.data.kind == 'power'
                      && request.resource.data.isOn is bool
                      && request.resource.data.by == uid();
        allow update, delete: if false;
      }

      // The estate's security guards, keyed by their uid. A guard gets in by redeeming a one-time
      // code an admin made (guardCodes below), which is deleted in the same batch so it can't be
      // used twice. Someone who lives in an estate can't sign on as a guard. Admins can remove a
      // guard at any time, and a guard can leave.
      match /guards/{guardId} {
        function guardCodePath(code) {
          return /databases/$(database)/documents/guardCodes/$(code);
        }

        allow read: if isEstateAdmin(estateId) || (isSignedIn() && uid() == guardId);
        allow create: if isSignedIn()
                      && uid() == guardId
                      && myEstateId() == null
                      && request.resource.data.keys().hasOnly(['userId', 'name', 'code', 'addedAt'])
                      && request.resource.data.userId == uid()
                      && request.resource.data.name is string
                      && request.resource.data.name.size() <= 100
                      && request.resource.data.addedAt is int
                      && request.resource.data.code is string
                      && get(guardCodePath(request.resource.data.code)).data.estateId == estateId
                      && request.time.toMillis() < get(guardCodePath(request.resource.data.code)).data.expiresAt
                      && !existsAfter(guardCodePath(request.resource.data.code));
        allow update: if false;
        allow delete: if isEstateAdmin(estateId) || (isSignedIn() && uid() == guardId);
      }

      // A resident expecting a visitor makes a pass, keyed by its code. The guard types in the
      // code the visitor gives them and sees that one pass. They can't list passes, so they can't
      // see who else is expected, only the visitors inside right now, to check them out.
      match /visitorPasses/{code} {
        function isResident() {
          return isSignedIn() && resource.data.residentId == uid();
        }

        function now() {
          return request.time.toMillis();
        }

        // A guard sees a pass only while it's usable: expected and not expired, or inside.
        function guardMaySee() {
          return isGuardOf(estateId)
                 && (resource.data.stage == 'inside'
                     || (resource.data.stage == 'expected' && now() < resource.data.validUntil));
        }

        // The resident who made it is still in the estate.
        function residentStillHere() {
          return get(/databases/$(database)/documents/users/$(resource.data.residentId)).data.get('estateId', null) == estateId;
        }

        // A guard lets the visitor in, on the day the pass is for, and stamps it with who and when.
        function checkIn() {
          let data = request.resource.data;
          return isGuardOf(estateId)
                 && resource.data.stage == 'expected'
                 && now() >= resource.data.validFrom
                 && now() < resource.data.validUntil
                 && residentStillHere()
                 && changedKeys().hasOnly(['stage', 'checkedInAt', 'checkedInBy', 'checkedInByName'])
                 && data.stage == 'inside'
                 && data.checkedInBy == uid()
                 && data.checkedInAt is int
                 && math.abs(data.checkedInAt - now()) < 10 * 60 * 1000
                 && data.checkedInByName is string
                 && data.checkedInByName.size() <= 100;
        }

        // A guard records the visitor leaving. Allowed after the pass's day, for late stays.
        function checkOut() {
          let data = request.resource.data;
          return isGuardOf(estateId)
                 && resource.data.stage == 'inside'
                 && changedKeys().hasOnly(['stage', 'checkedOutAt', 'checkedOutBy', 'checkedOutByName'])
                 && data.stage == 'left'
                 && data.checkedOutBy == uid()
                 && data.checkedOutAt is int
                 && math.abs(data.checkedOutAt - now()) < 10 * 60 * 1000
                 && data.checkedOutByName is string
                 && data.checkedOutByName.size() <= 100;
        }

        function passValid() {
          let data = request.resource.data;
          return data.keys().hasOnly(['code', 'residentId', 'residentName', 'residentAddress', 'visitorName',
                                      'note', 'validFrom', 'validUntil', 'createdAt', 'stage'])
                 && data.code == code
                 && code.matches('^[A-HJ-NP-Z2-9]{6}$')
                 && data.residentId == uid()
                 && data.stage == 'expected'
                 && data.visitorName is string
                 && data.visitorName.size() > 0
                 && data.visitorName.size() <= 80
                 && data.residentName is string
                 && data.residentName.size() <= 100
                 && data.get('residentAddress', '') is string
                 && data.get('residentAddress', '').size() <= 200
                 && data.get('note', '') is string
                 && data.get('note', '').size() <= 200
                 && data.createdAt is int
                 // One day at a time, starting within the next week, and not already over.
                 && data.validFrom is int
                 && data.validUntil is int
                 && data.validUntil > now()
                 && data.validUntil - data.validFrom <= 26 * 60 * 60 * 1000
                 && data.validFrom < now() + 8 * 24 * 60 * 60 * 1000;
        }

        allow get: if isResident() || guardMaySee();
        // Residents list their own passes; guards list only who is inside now. Each of these
        // must be provable from the query alone (residentId == uid, or stage == 'inside').
        allow list: if isResident()
                    || (isGuardOf(estateId) && resource.data.stage == 'inside');
        // A pass with this code already existing turns the write into an update, which fails, so
        // nobody can overwrite someone else's pass by guessing its code.
        allow create: if isMemberOf(estateId) && passValid();
        allow update: if (isResident()
                          && resource.data.stage == 'expected'
                          && changedKeys().hasOnly(['stage'])
                          && request.resource.data.stage == 'cancelled')
                      || checkIn()
                      || checkOut();
        // The resident clears old passes, but not one for a visitor who's inside.
        allow delete: if isResident() && resource.data.stage != 'inside';
      }
    }

    // App-wide settings set from the console, such as the oldest app version still allowed.
    // Readable before sign-in, so an outdated app can say so on its first screen.
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Maps an invite code to its estate. Fetchable only by someone who already knows the
    // code — listing is off, so codes cannot be enumerated.
    match /inviteCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isEstateAdminAfter(request.resource.data.estateId);
      allow update: if false;
      allow delete: if isEstateAdmin(resource.data.estateId);
    }

    // One-time codes an admin makes to sign a security guard on to their estate. Fetchable only
    // by someone who already knows the code, and gone once a guard has used it (see guards).
    match /guardCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isEstateAdmin(request.resource.data.estateId)
                    && code.matches('^[A-HJ-NP-Z2-9]{8}$')
                    && request.resource.data.keys().hasOnly(['estateId', 'createdBy', 'createdAt', 'expiresAt'])
                    && request.resource.data.createdBy == uid()
                    && request.resource.data.expiresAt is int
                    && request.resource.data.expiresAt <= request.time.toMillis() + 2 * 24 * 60 * 60 * 1000;
      allow update: if false;
      // An admin withdraws it, or the guard using it deletes it as they sign on.
      allow delete: if isEstateAdmin(resource.data.estateId)
                    || (isSignedIn()
                        && getAfter(/databases/$(database)/documents/estates/$(resource.data.estateId)/guards/$(uid())).data.code == code);
    }

    // Reports of posts, comments, chats and people, and feedback from Settings. Users can
    // send them but not read, change or delete them; they're reviewed in the Firebase console.
    match /reports/{reportId} {
      function optionalString(field, max) {
        return request.resource.data.get(field, null) == null
               || (request.resource.data[field] is string && request.resource.data[field].size() <= max);
      }

      allow create: if isSignedIn()
                    && request.resource.data.keys().hasOnly([
                         'subject', 'reason', 'details', 'targetId', 'postId', 'targetUserId',
                         'excerpt', 'reporterId', 'estateId', 'appVersion', 'status', 'createdAt'])
                    && request.resource.data.reporterId == uid()
                    && request.resource.data.subject in ['post', 'comment', 'chat', 'user', 'app']
                    && request.resource.data.reason is string && request.resource.data.reason.size() <= 40
                    && request.resource.data.details is string && request.resource.data.details.size() <= 2000
                    && request.resource.data.targetId is string && request.resource.data.targetId.size() <= 200
                    && request.resource.data.status == 'open'
                    && request.resource.data.createdAt is int
                    && optionalString('postId', 200)
                    && optionalString('targetUserId', 200)
                    && optionalString('excerpt', 1000)
                    && optionalString('estateId', 200)
                    && optionalString('appVersion', 40);
      allow read, update, delete: if false;
    }

    match /joinRequests/{requestId} {
      function isRequester() {
        return isSignedIn() && resource.data.userId == uid();
      }

      // A requester may file a pending request, or an approved one carrying a valid code, as
      // far as the estate's join mode allows each.
      function validRequest() {
        let data = request.resource.data;
        let mode = get(/databases/$(database)/documents/estates/$(data.estateId)).data.get('joinMode', 'both');
        return data.userId == uid()
               && data.estateId is string
               && requestId == data.estateId + '_' + uid()
               && ((data.status == 'pending' && mode != 'code')
                   || (data.status == 'approved'
                       && mode != 'request'
                       && inviteCodeOpens(data.get('inviteCode', null), data.estateId)
                       // Someone an admin removed needs an admin to let them back in.
                       && !exists(/databases/$(database)/documents/estates/$(data.estateId)/removed/$(uid()))));
      }

      allow read: if isRequester() || isEstateAdmin(resource.data.estateId);
      allow create: if isSignedIn() && validRequest();
      allow update: if isSignedIn() && (
        // Approving or denying is an admin decision; a requester cannot approve their own
        // without a code.
        (changedKeys().hasOnly(['status', 'reviewedAt'])
          && request.resource.data.status in ['approved', 'denied']
          && isEstateAdmin(resource.data.estateId))
        // Asking again after a denial, or switching to an invite code.
        || (isRequester() && request.resource.data.estateId == resource.data.estateId && validRequest())
      );
      // Requesters withdraw their own request (also on leaving); admins clear old ones.
      allow delete: if isSignedIn() && (
        resource == null || isRequester() || isEstateAdmin(resource.data.estateId)
      );
    }

    match /notifications/{notificationId} {
      function estateOf(estateId) {
        return get(/databases/$(database)/documents/estates/$(estateId)).data;
      }

      // Each kind of notice can only come from the person whose action it reports, and only go
      // to someone it concerns, so nobody can drop a made-up notice into a stranger's inbox.
      // The push Worker checks the same things again before it sends anything.
      function senderMayRaise(data) {
        let type = data.type;
        let estateId = data.estateId;
        return (type == 'JOIN_REQUEST'
                && data.recipientId in estateOf(estateId).adminIds
                && get(/databases/$(database)/documents/joinRequests/$(estateId + '_' + uid())).data.status == 'pending')
            || (type in ['REQUEST_APPROVED', 'REQUEST_DENIED', 'MEMBER_REMOVED', 'POST_REMOVED']
                && isEstateAdmin(estateId))
            || (type == 'OWNERSHIP_TRANSFERRED'
                && isEstateAdmin(estateId)
                && estateOf(estateId).get('ownerId', '') == data.recipientId)
            || (type in ['MENTION', 'COMMENT']
                && isMemberOf(estateId)
                && get(/databases/$(database)/documents/users/$(data.recipientId)).data.get('estateId', null) == estateId)
            || (type == 'PAYMENT_SUBMITTED'
                && isMemberOf(estateId)
                && estateOf(estateId).get('treasurerId', '') == data.recipientId)
            || (type in ['PAYMENT_CONFIRMED', 'PAYMENT_REJECTED']
                && isTreasurerOf(estateId));
      }

      // Raised by whoever triggered the event (a join requester notifying an admin).
      // senderId must be the writer: the push Worker relies on it to tell who raised an alert.
      allow create: if isSignedIn()
                    && request.resource.data.recipientId is string
                    && request.resource.data.senderId == uid()
                    && request.resource.data.isRead == false
                    && request.resource.data.estateId is string
                    && request.resource.data.get('title', '') is string
                    && request.resource.data.get('title', '').size() <= 200
                    && request.resource.data.get('message', '') is string
                    && request.resource.data.get('message', '').size() <= 1000
                    && senderMayRaise(request.resource.data);
      allow read, delete: if isSignedIn() && resource.data.recipientId == uid();
      allow update: if isSignedIn()
                    && resource.data.recipientId == uid()
                    && changedKeys().hasOnly(['isRead']);
    }

    match /posts/{postId} {
      // Posts are for the estate they were made in. The estate's guards also see its emergencies,
      // so they can go and help, but nothing else on the feed.
      allow read: if isMemberOf(resource.data.estateId)
                  || (resource.data.get('category', '') == 'emergency' && isGuardOf(resource.data.estateId));
      // Announcements carry the estate's authority, so only admins and the treasurer may post or keep one.
      function categoryAllowed() {
        return request.resource.data.get('category', '') != 'announcement'
               || isEstateAdmin(request.resource.data.estateId)
               || isTreasurerOf(request.resource.data.estateId);
      }

      function isIncident(category) {
        return category in ['security', 'emergency'];
      }

      // Security reports and emergencies start open, and an emergency says what kind it is.
      function incidentValid() {
        let data = request.resource.data;
        let category = data.get('category', '');
        return !isIncident(category)
               || (data.get('incidentStatus', '') == 'open'
                   && data.get('location', '') is string
                   && data.get('location', '').size() <= 200
                   && (category != 'emergency'
                       || data.get('emergencyType', '') in ['break_in', 'fire', 'medical', 'other']));
      }

      // An admin can turn off a member's SOS alerts (estates/{id}/sosMembers), and then they
      // can't raise an emergency. No record means nobody has.
      function sosAllowed(estateId) {
        let path = /databases/$(database)/documents/estates/$(estateId)/sosMembers/$(uid());
        return !exists(path) || get(path).data.get('disabled', false) != true;
      }

      // The record a false alarm leaves in its estate, which counts against the sender.
      function falseAlarmPath() {
        return /databases/$(database)/documents/estates/$(resource.data.estateId)/falseAlarms/$(postId);
      }

      // An emergency becomes a false alarm only with its record written in the same batch, and only
      // an admin takes the mark back off, deleting the record with it.
      function falseAlarmChangeValid() {
        let before = resource.data.get('falseAlarm', false);
        let after = request.resource.data.get('falseAlarm', false);
        return before == after
               || (after == true && resource.data.get('category', '') == 'emergency' && existsAfter(falseAlarmPath()))
               || (after == false && isEstateAdmin(resource.data.estateId) && !existsAfter(falseAlarmPath()));
      }

      function likeToggleValid() {
        let before = resource.data.get('likedBy', []).toSet();
        let after = request.resource.data.get('likedBy', []).toSet();
        let count = resource.data.get('likeCount', 0);
        return (after.difference(before) == [uid()].toSet()
                && before.difference(after).size() == 0
                && request.resource.data.likeCount == count + 1)
               || (before.difference(after) == [uid()].toSet()
                   && after.difference(before).size() == 0
                   && request.resource.data.likeCount == count - 1);
      }

      // Only admins move a report between open, handling and resolved. The one thing an author
      // may do is close their own emergency, saying they're safe now, stamped with their own id.
      function authorStatusChangeValid() {
        let data = request.resource.data;
        return !changedKeys().hasAny(['incidentStatus', 'statusUpdatedBy', 'statusUpdatedByName', 'statusUpdatedAt'])
               || (resource.data.get('category', '') == 'emergency'
                   && data.get('incidentStatus', '') == 'resolved'
                   && data.statusUpdatedBy == uid());
      }

      // The composer stops at 2,000 characters (MAX_POST_LENGTH in CreatePostScreen).
      function contentValid() {
        return request.resource.data.get('content', '') is string
               && request.resource.data.get('content', '').size() <= 2000;
      }

      allow create: if isSignedIn()
                    && request.resource.data.authorId == uid()
                    && isMemberOf(request.resource.data.estateId)
                    && categoryAllowed()
                    && incidentValid()
                    && contentValid()
                    && request.resource.data.get('falseAlarm', false) == false
                    && (request.resource.data.get('category', '') != 'emergency' || sosAllowed(request.resource.data.estateId))
                    // An SOS never waits on the gap between posts.
                    && (request.resource.data.get('category', '') == 'emergency' || stampedFor('lastPostAt', 'lastPostId', postId));
      allow update: if isSignedIn() && (
        (resource.data.authorId == uid()
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.estateId == resource.data.estateId
          && contentValid()
          && request.resource.data.get('createdAt', 0) == resource.data.get('createdAt', 0)
          && (!changedKeys().hasAny(['content', 'mentions', 'location', 'editedAt']) || withinEditWindow())
          && (request.resource.data.get('category', '') == resource.data.get('category', '') || categoryAllowed())
          // An old post can't be turned into an emergency, which would pin it to everyone's feed.
          && (request.resource.data.get('category', '') != 'emergency'
              || resource.data.get('category', '') == 'emergency')
          && falseAlarmChangeValid()
          // Likes, comment counts and responders go through their own rules below, for
          // everyone, the author included.
          && !changedKeys().hasAny(['likedBy', 'likeCount', 'commentCount', 'responders'])
          && authorStatusChangeValid())
        // Admins move a security report or emergency from open to resolved, or mark an emergency a
        // false alarm (or take that back), and change nothing else.
        || (isIncident(resource.data.get('category', ''))
            && isEstateAdmin(resource.data.estateId)
            && changedKeys().hasOnly(['incidentStatus', 'statusUpdatedBy', 'statusUpdatedByName', 'statusUpdatedAt',
                                      'falseAlarm', 'falseAlarmByName'])
            && falseAlarmChangeValid()
            && request.resource.data.incidentStatus in ['open', 'handling', 'resolved']
            && request.resource.data.statusUpdatedBy == uid())
        // A neighbour may like a post or comment on it. Neither may rewrite its body. A like
        // adds the caller, and only the caller, and counts one; an unlike takes one off.
        || (isMemberOf(resource.data.estateId) && (
             (changedKeys().hasOnly(['likedBy', 'likeCount']) && likeToggleValid())
             || (changedKeys().hasOnly(['commentCount'])
                 && (request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
                     || request.resource.data.commentCount == resource.data.get('commentCount', 0) - 1))
           ))
        // A neighbour or one of the estate's guards says they're on their way to an emergency: they
        // add themselves, by name, and touch nobody else's entry.
        || ((isMemberOf(resource.data.estateId) || isGuardOf(resource.data.estateId))
            && resource.data.get('category', '') == 'emergency'
            && changedKeys().hasOnly(['responders'])
            && request.resource.data.responders.diff(resource.data.get('responders', {})).affectedKeys().hasOnly([uid()])
            && request.resource.data.responders[uid()] is string)
      );
      // Authors remove their own posts; admins can remove any post in their estate.
      allow delete: if isSignedIn() && (
        resource.data.authorId == uid()
        || isEstateAdmin(resource.data.estateId)
      );

      match /comments/{commentId} {
        function postEstate() {
          return get(/databases/$(database)/documents/posts/$(postId)).data.estateId;
        }

        allow read: if isMemberOf(postEstate());
        allow create: if isSignedIn()
                      && request.resource.data.authorId == uid()
                      && isMemberOf(postEstate())
                      && request.resource.data.content is string
                      && request.resource.data.content.size() <= 1000
                      && stampedFor('lastCommentAt', 'lastCommentId', commentId);
        // Its author rewrites the text, for 30 minutes after writing it.
        allow update: if isSignedIn()
                      && resource.data.authorId == uid()
                      && isMemberOf(postEstate())
                      && changedKeys().hasOnly(['content', 'mentions', 'editedAt'])
                      && request.resource.data.content is string
                      && request.resource.data.content.size() <= 1000
                      && withinEditWindow();
        // The comment's author, the author of the post being commented on, or an admin of its
        // estate (deleting a post takes its comments with it).
        allow delete: if isSignedIn() && (
          resource.data.authorId == uid()
          || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == uid()
          || isEstateAdmin(postEstate())
        );
      }
    }

    // A chat's id is its two participants' uids, sorted and joined with "_". Creation
    // enforces that, so membership can be read straight off the id — which also covers
    // a conversation that has been opened but has no document until its first message.
    match /chats/{chatId} {
      function isMember() {
        return isSignedIn() && uid() in chatId.split('_');
      }

      function otherMember() {
        let ids = chatId.split('_');
        return ids[0] == uid() ? ids[1] : ids[0];
      }

      // Messages only go between neighbours: nobody can message someone outside their estate
      // (including someone removed from it), a deleted account, someone they've blocked, or
      // someone who has blocked them.
      function canMessage() {
        let other = otherMember();
        let mine = myEstateId();
        return mine != null
               && get(/databases/$(database)/documents/users/$(other)).data.get('estateId', null) == mine
               && !exists(/databases/$(database)/documents/users/$(uid())/blocks/$(other))
               && !exists(/databases/$(database)/documents/users/$(other)/blocks/$(uid()));
      }

      // A missing chat must read as missing: the app opens a conversation before its
      // first message exists, and an erroring rule would surface as PERMISSION_DENIED.
      allow get: if isSignedIn() && (resource == null || uid() in resource.data.participants);
      // Must stay provable from the `participants array-contains uid` query alone, so
      // no type checks or lookups here — Firestore rejects a list rule it cannot prove.
      allow list: if isSignedIn() && uid() in resource.data.participants;
      allow create: if isMember()
                    && request.resource.data.participants is list
                    && request.resource.data.participants.size() == 2
                    && uid() in request.resource.data.participants
                    && (chatId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
                        || chatId == request.resource.data.participants[1] + '_' + request.resource.data.participants[0]);
      // Participants keep the preview, names and unread tallies current; nobody can
      // add or remove a member.
      allow update: if isSignedIn()
                    && uid() in resource.data.participants
                    && request.resource.data.participants.toSet() == resource.data.participants.toSet();
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isMember();
        allow create: if isMember()
                      && canMessage()
                      && request.resource.data.senderId == uid()
                      && request.resource.data.chatId == chatId
                      && request.resource.data.content is string
                      && request.resource.data.content.size() > 0
                      && request.resource.data.content.size() <= 5000;
        // Messages are immutable once sent.
        allow update, delete: if false;
      }
    }

  }
}
