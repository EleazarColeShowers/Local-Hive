rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // The keys this write adds, removes or changes.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // The estate the caller currently belongs to, or null.
    function myEstateId() {
      return get(/databases/$(database)/documents/users/$(uid())).data.get('estateId', null);
    }

    function isMemberOf(estateId) {
      return isSignedIn() && estateId != null && myEstateId() == estateId;
    }

    function isEstateAdmin(estateId) {
      return isSignedIn()
             && uid() in get(/databases/$(database)/documents/estates/$(estateId)).data.adminIds;
    }

    // The member an admin appointed to look after the estate's money.
    function isTreasurerOf(estateId) {
      return isSignedIn()
             && get(/databases/$(database)/documents/estates/$(estateId)).data.get('treasurerId', '') == uid();
    }

    // As isEstateAdmin, but sees writes earlier in the same batch — creating an estate
    // and attaching its creator to it happen together.
    function isEstateAdminAfter(estateId) {
      return isSignedIn()
             && uid() in getAfter(/databases/$(database)/documents/estates/$(estateId)).data.adminIds;
    }

    // A join request is the only way into an estate besides creating it. Admins approve
    // requests; a valid invite code lets the requester approve their own.
    function hasApprovedRequest(estateId, userId) {
      return getAfter(/databases/$(database)/documents/joinRequests/$(estateId + '_' + userId)).data.status == 'approved';
    }

    function inviteCodeOpens(code, estateId) {
      return code is string
             && get(/databases/$(database)/documents/inviteCodes/$(code)).data.estateId == estateId;
    }

    match /users/{userId} {
      // Neighbours see each other; nobody sees residents of other estates.
      // Written against resource.data.estateId directly so the directory's
      // `estateId == X` query can be proven safe as a whole.
      allow read: if isSignedIn() && (
        uid() == userId
        || (myEstateId() != null && resource.data.estateId == myEstateId())
      );
      // New accounts start outside any estate and must join one through the flow below.
      allow create: if isSignedIn() && uid() == userId
                    && request.resource.data.get('estateId', null) == null;
      allow update: if isSignedIn() && (
        (uid() == userId && (
          !('estateId' in changedKeys())
          // Leaving.
          || request.resource.data.get('estateId', null) == null
          // Joining: an estate they just created, or one that has let them in.
          || isEstateAdminAfter(request.resource.data.estateId)
          || hasApprovedRequest(request.resource.data.estateId, userId)
        ))
        // An admin approving a request attaches that requester, and only that requester,
        // to their estate. It is the only field they may touch on somebody else's profile.
        || (changedKeys().hasOnly(['estateId'])
            && isEstateAdmin(request.resource.data.estateId)
            && hasApprovedRequest(request.resource.data.estateId, userId))
        // An admin removing a member from their estate. Admins (and so the owner) have to
        // lose admin first, so one admin can't throw out another in a single step.
        || (changedKeys().hasOnly(['estateId'])
            && request.resource.data.get('estateId', null) == null
            && resource.data.get('estateId', null) is string
            && isEstateAdmin(resource.data.estateId)
            && !(userId in get(/databases/$(database)/documents/estates/$(resource.data.estateId)).data.adminIds))
      );
      allow delete: if isSignedIn() && uid() == userId;

      // People this user has blocked. Private: the blocked person can't tell.
      match /blocks/{blockedId} {
        allow read, delete: if isSignedIn() && uid() == userId;
        allow create, update: if isSignedIn() && uid() == userId && blockedId != userId;
      }
    }

    match /estates/{estateId} {
      // Public so people can find an estate to request; invite codes live elsewhere.
      allow read: if isSignedIn();
      // Whoever creates an estate must be an admin of it, so it always has an owner.
      allow create: if isSignedIn()
                    && request.resource.data.adminIds is list
                    && uid() in request.resource.data.adminIds
                    && request.resource.data.ownerId == uid()
                    && request.resource.data.memberCount == 1
                    && nameLowerMatches()
                    && !('inviteCode' in request.resource.data);
      allow update: if isSignedIn() && (
        (uid() in resource.data.adminIds
          && !('inviteCode' in request.resource.data)
          && detailsValid()
          && ownerKept())
        // Joining or leaving moves the tally by one and touches nothing else — in
        // particular a member cannot write themselves into adminIds.
        || (changedKeys().hasOnly(['memberCount'])
            && (request.resource.data.memberCount == resource.data.memberCount + 1
                || request.resource.data.memberCount == resource.data.memberCount - 1))
        // A treasurer who isn't an admin gives the role up as they leave, and nothing more.
        || (changedKeys().hasOnly(['memberCount', 'treasurerId'])
            && resource.data.get('treasurerId', '') == uid()
            && request.resource.data.get('treasurerId', '') == ''
            && request.resource.data.memberCount == resource.data.memberCount - 1)
      );
      allow delete: if isSignedIn() && uid() in resource.data.adminIds;

      // An estate always has a name, and lets people in in one of the known ways.
      function detailsValid() {
        let data = request.resource.data;
        return data.name is string
               && data.name.size() > 0
               && data.name.size() <= 80
               && data.get('address', '') is string
               && data.get('address', '').size() <= 200
               && data.get('joinMode', 'both') in ['both', 'code', 'request']
               && nameLowerMatches();
      }

      // Search runs on nameLower, so it can't be set to anything but the name in lowercase.
      // Estates from before it existed may lack it until the backfill fills it in.
      function nameLowerMatches() {
        let data = request.resource.data;
        return data.get('nameLower', data.name.lower()) == data.name.lower();
      }

      // The owner stays an admin no matter what other admins do. Only the owner can change
      // that, by handing ownership to another member, who becomes an admin with it. The
      // owner may stay on as an admin, or drop admin as they leave.
      function ownerKept() {
        let owner = resource.data.get('ownerId', null);
        let next = request.resource.data.get('ownerId', null);
        return (next == owner && (owner == null || owner in request.resource.data.adminIds))
               || (uid() == owner
                   && next is string
                   && next != owner
                   && next in request.resource.data.adminIds
                   && get(/databases/$(database)/documents/users/$(next)).data.get('estateId', null) == estateId);
      }

      // Dues: the treasurer sets them; every member can see what's owed.
      match /levies/{levyId} {
        allow read: if isMemberOf(estateId);
        allow create, update: if isTreasurerOf(estateId)
                              && request.resource.data.title is string
                              && request.resource.data.amount is int
                              && request.resource.data.amount > 0;
        allow delete: if isTreasurerOf(estateId);

        // One per resident, keyed by their uid. Only they and the treasurer can see it.
        match /payments/{userId} {
          allow read: if isSignedIn() && (uid() == userId || isTreasurerOf(estateId));
          // A resident sends proof for themselves. It always arrives pending, and can't be
          // replaced once the treasurer has confirmed it.
          allow create, update: if (isSignedIn()
                                    && uid() == userId
                                    && isMemberOf(estateId)
                                    && request.resource.data.userId == uid()
                                    && request.resource.data.status == 'pending'
                                    && request.resource.data.keys().hasOnly(
                                         ['userId', 'userName', 'levyId', 'amount', 'status', 'proofUrl', 'submittedAt'])
                                    && (resource == null || resource.data.status != 'paid'))
                                // The treasurer confirms, rejects or records a cash payment.
                                || (isTreasurerOf(estateId)
                                    && request.resource.data.userId == userId
                                    && request.resource.data.status in ['pending', 'paid', 'rejected']);
          allow delete: if isTreasurerOf(estateId);
        }
      }

      // Spending is logged by the treasurer and open to every member, for transparency.
      match /expenses/{expenseId} {
        allow read: if isMemberOf(estateId);
        allow create, update: if isTreasurerOf(estateId)
                              && request.resource.data.amount is int
                              && request.resource.data.amount > 0;
        allow delete: if isTreasurerOf(estateId);
      }

      // Members-only details: the current invite code, which admins set, and where to pay
      // dues, which the treasurer sets.
      match /private/{docId} {
        allow read: if isMemberOf(estateId) || isEstateAdmin(estateId);
        allow create, update: if (docId != 'bank' && isEstateAdminAfter(estateId))
                              || (docId == 'bank'
                                  && isTreasurerOf(estateId)
                                  && request.resource.data.keys().hasOnly(
                                       ['bankName', 'accountNumber', 'accountName', 'updatedBy', 'updatedByName', 'updatedAt'])
                                  && request.resource.data.updatedBy == uid()
                                  && request.resource.data.accountNumber is string
                                  && request.resource.data.accountNumber.size() > 0
                                  && request.resource.data.accountNumber.size() <= 20);
        allow delete: if (docId != 'bank' && isEstateAdminAfter(estateId))
                      || (docId == 'bank' && isTreasurerOf(estateId));
      }

      // Polls: admins ask, every member votes once. The tallies live on the poll for all to see;
      // each vote is a separate document only its voter can read. A vote and its tally are
      // written in one batch, and the two rules below hold each to the other.
      function pollPath(pollId) {
        return /databases/$(database)/documents/estates/$(estateId)/polls/$(pollId);
      }

      function votePath(pollId) {
        return /databases/$(database)/documents/estates/$(estateId)/pollVotes/$(pollId + '_' + uid());
      }

      function pollOpen(poll) {
        return poll.closed == false
               && (poll.closesAt == 0 || request.time.toMillis() < poll.closesAt);
      }

      match /polls/{pollId} {
        allow read: if isMemberOf(estateId);
        allow create: if isEstateAdmin(estateId)
                      && request.resource.data.createdBy == uid()
                      && request.resource.data.question is string
                      && request.resource.data.question.size() > 0
                      && request.resource.data.question.size() <= 200
                      && request.resource.data.options is list
                      && request.resource.data.options.size() >= 2
                      && request.resource.data.options.size() <= 6
                      && request.resource.data.closesAt is int
                      && request.resource.data.closed == false
                      && request.resource.data.counts.size() == 0
                      && request.resource.data.voteCount == 0;
        allow update: if (isEstateAdmin(estateId)
                          && changedKeys().hasOnly(['closed'])
                          && request.resource.data.closed == true)
                      || tallyForNewVote();
        allow delete: if isEstateAdmin(estateId);

        // The caller's vote document appears in this same batch, and the option it names, and
        // only that one, goes up by one.
        function tallyForNewVote() {
          let option = string(getAfter(votePath(pollId)).data.option);
          return isMemberOf(estateId)
                 && pollOpen(resource.data)
                 && !exists(votePath(pollId))
                 && existsAfter(votePath(pollId))
                 && changedKeys().hasOnly(['counts', 'voteCount'])
                 && request.resource.data.voteCount == resource.data.voteCount + 1
                 && request.resource.data.counts.diff(resource.data.counts).affectedKeys().hasOnly([option])
                 && request.resource.data.counts[option] == resource.data.counts.get(option, 0) + 1;
        }
      }

      match /pollVotes/{voteId} {
        allow read: if isSignedIn() && resource.data.userId == uid();
        // One per member per poll, keyed "<pollId>_<uid>", and final: never changed or removed.
        allow create: if isMemberOf(estateId)
                      && request.resource.data.keys().hasOnly(['pollId', 'userId', 'option', 'at'])
                      && request.resource.data.userId == uid()
                      && request.resource.data.pollId is string
                      && voteId == request.resource.data.pollId + '_' + uid()
                      && request.resource.data.option is int
                      && request.resource.data.option >= 0
                      && request.resource.data.option < get(pollPath(request.resource.data.pollId)).data.options.size()
                      && getAfter(pollPath(request.resource.data.pollId)).data.voteCount
                         == get(pollPath(request.resource.data.pollId)).data.voteCount + 1;
        allow update, delete: if false;
      }

      // "Is there light?": the latest word on each supply, and every report behind it.
      match /utilities/{kind} {
        allow read: if isMemberOf(estateId);
        allow create, update: if isMemberOf(estateId)
                              && kind == 'power'
                              && request.resource.data.keys().hasOnly(['isOn', 'since', 'updatedAt', 'updatedBy', 'updatedByName'])
                              && request.resource.data.isOn is bool
                              && request.resource.data.updatedBy == uid();
        allow delete: if false;
      }

      match /utilityReports/{reportId} {
        allow read: if isMemberOf(estateId);
        allow create: if isMemberOf(estateId)
                      && request.resource.data.keys().hasOnly(['kind', 'isOn', 'by', 'byName', 'at'])
                      && request.resource.data.kind == 'power'
                      && request.resource.data.isOn is bool
                      && request.resource.data.by == uid();
        allow update, delete: if false;
      }
    }

    // Maps an invite code to its estate. Fetchable only by someone who already knows the
    // code — listing is off, so codes cannot be enumerated.
    match /inviteCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isEstateAdminAfter(request.resource.data.estateId);
      allow update: if false;
      allow delete: if isEstateAdmin(resource.data.estateId);
    }

    match /joinRequests/{requestId} {
      function isRequester() {
        return isSignedIn() && resource.data.userId == uid();
      }

      // A requester may file a pending request, or an approved one carrying a valid code, as
      // far as the estate's join mode allows each.
      function validRequest() {
        let data = request.resource.data;
        let mode = get(/databases/$(database)/documents/estates/$(data.estateId)).data.get('joinMode', 'both');
        return data.userId == uid()
               && data.estateId is string
               && requestId == data.estateId + '_' + uid()
               && ((data.status == 'pending' && mode != 'code')
                   || (data.status == 'approved'
                       && mode != 'request'
                       && inviteCodeOpens(data.get('inviteCode', null), data.estateId)));
      }

      allow read: if isRequester() || isEstateAdmin(resource.data.estateId);
      allow create: if isSignedIn() && validRequest();
      allow update: if isSignedIn() && (
        // Approving or denying is an admin decision; a requester cannot approve their own
        // without a code.
        (changedKeys().hasOnly(['status', 'reviewedAt'])
          && request.resource.data.status in ['approved', 'denied']
          && isEstateAdmin(resource.data.estateId))
        // Asking again after a denial, or switching to an invite code.
        || (isRequester() && request.resource.data.estateId == resource.data.estateId && validRequest())
      );
      // Requesters withdraw their own request (also on leaving); admins clear old ones.
      allow delete: if isSignedIn() && (
        resource == null || isRequester() || isEstateAdmin(resource.data.estateId)
      );
    }

    match /notifications/{notificationId} {
      // Raised by whoever triggered the event (a join requester notifying an admin),
      // so at create time the recipient is somebody other than the writer.
      // senderId must be the writer: the push Worker relies on it to tell who raised an alert.
      allow create: if isSignedIn()
                    && request.resource.data.recipientId is string
                    && request.resource.data.senderId == uid()
                    && request.resource.data.isRead == false;
      allow read, delete: if isSignedIn() && resource.data.recipientId == uid();
      allow update: if isSignedIn()
                    && resource.data.recipientId == uid()
                    && changedKeys().hasOnly(['isRead']);
    }

    match /posts/{postId} {
      // Posts are for the estate they were made in.
      allow read: if isMemberOf(resource.data.estateId);
      // Announcements carry an admin's authority, so only admins may post or keep one.
      function categoryAllowed() {
        return request.resource.data.get('category', '') != 'announcement'
               || isEstateAdmin(request.resource.data.estateId);
      }

      function isIncident(category) {
        return category in ['security', 'emergency'];
      }

      // Security reports and emergencies start open, and an emergency says what kind it is.
      function incidentValid() {
        let data = request.resource.data;
        let category = data.get('category', '');
        return !isIncident(category)
               || (data.get('incidentStatus', '') == 'open'
                   && data.get('location', '') is string
                   && data.get('location', '').size() <= 200
                   && (category != 'emergency'
                       || data.get('emergencyType', '') in ['break_in', 'fire', 'medical', 'other']));
      }

      allow create: if isSignedIn()
                    && request.resource.data.authorId == uid()
                    && isMemberOf(request.resource.data.estateId)
                    && categoryAllowed()
                    && incidentValid();
      allow update: if isSignedIn() && (
        (resource.data.authorId == uid()
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.estateId == resource.data.estateId
          && (request.resource.data.get('category', '') == resource.data.get('category', '') || categoryAllowed())
          // An old post can't be turned into an emergency, which would pin it to everyone's feed.
          && (request.resource.data.get('category', '') != 'emergency'
              || resource.data.get('category', '') == 'emergency'))
        // Admins move a security report or emergency from open to resolved, and change nothing else.
        || (isIncident(resource.data.get('category', ''))
            && isEstateAdmin(resource.data.estateId)
            && changedKeys().hasOnly(['incidentStatus', 'statusUpdatedBy', 'statusUpdatedByName', 'statusUpdatedAt'])
            && request.resource.data.incidentStatus in ['open', 'handling', 'resolved']
            && request.resource.data.statusUpdatedBy == uid())
        // A neighbour may like a post or comment on it. Neither may rewrite its body.
        || (isMemberOf(resource.data.estateId) && (
             changedKeys().hasOnly(['likedBy', 'likeCount'])
             || changedKeys().hasOnly(['commentCount'])
           ))
        // A neighbour says they're on their way to an emergency: they add themselves, by name,
        // and touch nobody else's entry.
        || (isMemberOf(resource.data.estateId)
            && resource.data.get('category', '') == 'emergency'
            && changedKeys().hasOnly(['responders'])
            && request.resource.data.responders.diff(resource.data.get('responders', {})).affectedKeys().hasOnly([uid()])
            && request.resource.data.responders[uid()] is string)
      );
      // Authors remove their own posts; admins can remove any post in their estate.
      allow delete: if isSignedIn() && (
        resource.data.authorId == uid()
        || isEstateAdmin(resource.data.estateId)
      );

      match /comments/{commentId} {
        function postEstate() {
          return get(/databases/$(database)/documents/posts/$(postId)).data.estateId;
        }

        allow read: if isMemberOf(postEstate());
        allow create: if isSignedIn()
                      && request.resource.data.authorId == uid()
                      && isMemberOf(postEstate());
        allow update: if false;
        // The comment's author, the author of the post being commented on, or an admin of its
        // estate (deleting a post takes its comments with it).
        allow delete: if isSignedIn() && (
          resource.data.authorId == uid()
          || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == uid()
          || isEstateAdmin(postEstate())
        );
      }
    }

    // A chat's id is its two participants' uids, sorted and joined with "_". Creation
    // enforces that, so membership can be read straight off the id — which also covers
    // a conversation that has been opened but has no document until its first message.
    match /chats/{chatId} {
      function isMember() {
        return isSignedIn() && uid() in chatId.split('_');
      }

      function otherMember() {
        let ids = chatId.split('_');
        return ids[0] == uid() ? ids[1] : ids[0];
      }

      // Nobody can message a deleted account, someone they've blocked, or someone who has
      // blocked them.
      function canMessage() {
        let other = otherMember();
        return exists(/databases/$(database)/documents/users/$(other))
               && !exists(/databases/$(database)/documents/users/$(uid())/blocks/$(other))
               && !exists(/databases/$(database)/documents/users/$(other)/blocks/$(uid()));
      }

      // A missing chat must read as missing: the app opens a conversation before its
      // first message exists, and an erroring rule would surface as PERMISSION_DENIED.
      allow get: if isSignedIn() && (resource == null || uid() in resource.data.participants);
      // Must stay provable from the `participants array-contains uid` query alone, so
      // no type checks or lookups here — Firestore rejects a list rule it cannot prove.
      allow list: if isSignedIn() && uid() in resource.data.participants;
      allow create: if isMember()
                    && request.resource.data.participants is list
                    && request.resource.data.participants.size() == 2
                    && uid() in request.resource.data.participants
                    && (chatId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
                        || chatId == request.resource.data.participants[1] + '_' + request.resource.data.participants[0]);
      // Participants keep the preview, names and unread tallies current; nobody can
      // add or remove a member.
      allow update: if isSignedIn()
                    && uid() in resource.data.participants
                    && request.resource.data.participants.toSet() == resource.data.participants.toSet();
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isMember();
        allow create: if isMember()
                      && canMessage()
                      && request.resource.data.senderId == uid()
                      && request.resource.data.chatId == chatId
                      && request.resource.data.content is string
                      && request.resource.data.content.size() > 0
                      && request.resource.data.content.size() <= 5000;
        // Messages are immutable once sent.
        allow update, delete: if false;
      }
    }

  }
}
