rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      // Lets an estate admin attach a user to their estate when approving a join request.
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estateId'])
                    && request.auth.uid in
                       get(/databases/$(database)/documents/estates/$(request.resource.data.estateId)).data.adminIds;
    }

    match /estates/{estateId} {
      allow read, write: if request.auth != null;
    }

    match /joinRequests/{requestId} {
      allow read, write: if request.auth != null;
    }

    match /notifications/{notificationId} {
      // Created by another user (e.g. join requester notifying an admin), so recipientId != auth.uid at create time.
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null
                    && resource.data.recipientId == request.auth.uid;
    }

    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
                    && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.authorId == request.auth.uid;
        allow delete: if request.auth != null
                      && resource.data.authorId == request.auth.uid;
      }
    }

  }
}
